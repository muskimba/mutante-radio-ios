# Build do app iOS e envio pro TestFlight.
#
# Assinatura: automática pelo Xcode, usando a App Store Connect API key
# (nada de certificado .p12 gerado à mão). A chave .p8 (gravada pelo workflow
# em ~/.appstoreconnect/private_keys/) é passada ao xcodebuild por
# -authenticationKeyPath/-ID/-IssuerID junto com -allowProvisioningUpdates;
# sem esses três o Xcode do CI não tem conta ("No Accounts") e não cria o
# certificado de distribuição nem o provisioning profile.
#
# Variáveis de ambiente (secrets do GitHub Actions):
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8 (base64) / APPLE_TEAM_ID

default_platform(:ios)

APP_ID = "com.mutanteradio.mutanteRadio"

platform :ios do
  desc "Build e enviar pro TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )

    team_id = ENV.fetch("APPLE_TEAM_ID")
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios/ipa",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Automatic",
        "FLUTTER_BUILD_NUMBER=#{build_number}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" "),
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "automatic"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true
    )
  end
end
